{
  "name": "denzic_audio_v1",
  "magic_ascii": "VKA1",
  "version": 1,
  "header_bytes": 20,
  "pcm": {
    "sample_rate_hz": 16000,
    "channels": 1,
    "sample_width_bits": 16
  },
  "packet_types": {
    "session_start": 1,
    "audio_data": 2,
    "session_stop": 3,
    "session_cancel": 4,
    "session_error": 5
  },
  "session_errors": {
    "none": 0,
    "queue_full": 1,
    "notify_timeout": 2,
    "link_lost": 3,
    "sequence_overflow": 4,
    "invalid_state": 5,
    "no_memory": 6,
    "packet_too_large": 7,
    "transport": 8
  },
  "lossless_rice": {
    "packet_flag": 1,
    "header_bytes": 6,
    "max_k": 15,
    "max_zigzag_residual": 1048560,
    "versions": {
      "v1": 1,
      "v2": 2,
      "v3": 3
    },
    "predictors": {
      "first_order": 1,
      "second_order": 2,
      "third_order": 3,
      "fourth_order": 4
    },
    "v1_predictor": 2,
    "v1_seed_samples": 2,
    "v2_max_predictor": 2,
    "v2_seed_samples": 2,
    "v2_parameter_k_span": 1,
    "v3_max_predictor": 4,
    "v3_seed_samples": "predictor_order",
    "v3_predictor_sample_stride": 16,
    "control_byte": {
      "v1": "rice_k in low byte; predictor is fixed second order",
      "v2": "high nibble = predictor order (1..2), low nibble = rice_k",
      "v3": "high nibble = predictor order (1..4, also the seed count), low nibble = rice_k"
    },
    "seed_sample_byte_order": "little_endian_i16",
    "zigzag_mapping": "residual >= 0 -> 2*residual; residual < 0 -> -2*residual - 1",
    "residual_coding": "unary quotient (zero bits terminated by a one bit) followed by k remainder bits, LSB first",
    "bit_order": "lsb_first_within_byte",
    "pcm_sample_byte_order": "little_endian_i16"
  }
}
